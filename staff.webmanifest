{
  "id": "/staff",
  "name": "RYST Staff — RYST 109A Dashboard",
  "short_name": "RYST Staff",
  "description": "Bookings, check-ins, checklists, food orders, petty cash and inventory for RYST 109A staff.",
  "start_url": "/login.html?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e2420",
  "theme_color": "#0e2420",
  "icons": [
    { "src": "/assets/staff-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/staff-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/staff-icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Bookings", "url": "/bookings.html", "icons": [{ "src": "/assets/staff-icon-192.png", "sizes": "192x192" }] },
    { "name": "Checklist", "url": "/checklist.html", "icons": [{ "src": "/assets/staff-icon-192.png", "sizes": "192x192" }] },
    { "name": "Petty Cash", "url": "/petty-cash.html", "icons": [{ "src": "/assets/staff-icon-192.png", "sizes": "192x192" }] },
    { "name": "Casa de RYST", "url": "/restaurant.html", "icons": [{ "src": "/assets/staff-icon-192.png", "sizes": "192x192" }] }
  ]
}
